{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.gavindu.securityagent.desktop",
  "productName": "Security Agent",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run build:webview",
    "beforeBuildCommand": "npm run build:webview",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Security Agent",
        "width": 950,
        "height": 820,
        "minWidth": 640,
        "minHeight": 500,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'; worker-src 'none'; media-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "shortDescription": "Local-first Mac agent",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
